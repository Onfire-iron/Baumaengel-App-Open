{
  "name": "baumaengel-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.ts",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs-assets.ts",
    "build": "vite build",
    "preview": "vite preview",
    "wlan": "npm run build && node scripts/make-cert.ts && vite preview --mode wlan",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "deploy": "npm run typecheck && npm run build && node scripts/deploy-sftp.ts",
    "android": "npm run typecheck && npm run build -- --mode android && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^26.6.6",
    "@types/node-forge": "^1.3.14",
    "node-forge": "^1.4.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@zip.js/zip.js": "^2.24.0",
    "dexie": "^4.4.7",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299"
  }
}
