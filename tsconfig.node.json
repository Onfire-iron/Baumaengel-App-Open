{
  // Einstellungen für alles, was unter Node läuft statt im Browser
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true, // Node kann so die .ts-Dateien in scripts/ direkt ausführen
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["vite.config.ts", "vitest.config.ts", "scripts"]
}
